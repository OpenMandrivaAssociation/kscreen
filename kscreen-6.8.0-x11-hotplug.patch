@@ -0,0 +1,29 @@
+# X11-only helper. KWin owns output configuration on Wayland; kwin_x11 does not
+# apply saved layouts, so this process does that job for the X11 session.
+
+find_package(Qt6 REQUIRED COMPONENTS DBus Gui)
+find_package(X11 REQUIRED)
+if(NOT X11_Xi_FOUND)
+    message(FATAL_ERROR "libXi is required to map X11 touchscreens onto outputs")
+endif()
+
+add_executable(kscreen_x11_hotplug
+    main.cpp
+    manager.cpp
+    manager.h
+    touch.cpp
+    touch.h
+)
+
+target_link_libraries(kscreen_x11_hotplug PRIVATE
+    KF6::Screen
+    Qt::DBus
+    Qt::Gui
+    X11::X11
+    X11::Xi
+)
+
+install(TARGETS kscreen_x11_hotplug DESTINATION ${KDE_INSTALL_LIBEXECDIR})
+
+configure_file(plasma-kscreen-x11.service.in plasma-kscreen-x11.service @ONLY)
+install(FILES ${CMAKE_CURRENT_BINARY_DIR}/plasma-kscreen-x11.service DESTINATION ${KDE_INSTALL_SYSTEMDUSERUNITDIR})
