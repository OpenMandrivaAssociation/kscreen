+/*
+    SPDX-FileCopyrightText: 2018 Kai Uwe Broulik <kde@broulik.de>
+    SPDX-FileCopyrightText: 2026 OpenMandriva
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "touch.h"
+
+#include <QGuiApplication>
+#include <QRect>
+#include <QTransform>
+
+#include <kscreen/config.h>
+#include <kscreen/output.h>
+
+#include <climits>
+#include <memory>
+
+#include <X11/Xlib.h>
+#include <X11/extensions/XInput.h>
+#include <X11/extensions/XInput2.h>
+
+namespace
+{
+struct DeviceListDeleter {
+    void operator()(XDeviceInfo *info) const
+    {
+        if (info) {
+            XFreeDeviceList(info);
+        }
+    }
+};
+
+struct XDeleter {
+    void operator()(void *data) const
+    {
+        if (data) {
+            XFree(data);
+        }
+    }
+};
+
+QRect outputRect(const KScreen::ConfigPtr &config, const KScreen::OutputPtr &output)
+{
+    const QSize size = config->logicalSizeForOutputInt(*output);
+    if (!size.isValid()) {
+        return {};
+    }
+    return QRect(output->pos(), size);
+}
+
+KScreen::OutputPtr touchTarget(const KScreen::ConfigPtr &config)
+{
+    const auto outputs = config->connectedOutputs();
+    KScreen::OutputPtr panel;
+    KScreen::OutputPtr primary;
+    int enabled = 0;
+    for (const auto &output : outputs) {
+        if (!output->isEnabled()) {
+            continue;
+        }
+        ++enabled;
+        if (!primary || output->priority() < primary->priority()) {
+            primary = output;
+        }
+        if (output->type() == KScreen::Output::Panel) {
+            panel = output;
+        }
+    }
+    if (panel) {
+        return panel;
+    }
+    if (enabled == 1) {
+        return primary;
+    }
+    return primary;
+}
+}
+
+void alignX11TouchScreen(const KScreen::ConfigPtr &config)
+{
+    if (!config || !qGuiApp || qGuiApp->platformName() != QLatin1String("xcb")) {
+        return;
+    }
+    auto *x11App = qGuiApp->nativeInterface<QNativeInterface::QX11Application>();
+    if (!x11App) {
+        return;
+    }
+    Display *display = x11App->display();
+    if (!display) {
+        return;
+    }
+
+    const KScreen::OutputPtr target = touchTarget(config);
+    if (!target) {
+        return;
+    }
+    const QRect internal = outputRect(config, target);
+    if (internal.isEmpty()) {
+        return;
+    }
+
+    QRect total;
+    const auto outputs = config->connectedOutputs();
+    for (const auto &output : outputs) {
+        if (!output->isEnabled()) {
+            continue;
+        }
+        const QRect rect = outputRect(config, output);
+        if (!rect.isEmpty()) {
+            total = total.united(rect);
+        }
+    }
+    if (total.isEmpty()) {
+        return;
+    }
+
+    int angle = 0;
+    switch (target->rotation()) {
+    case KScreen::Output::Left:
+        angle = 90;
+        break;
+    case KScreen::Output::Right:
+        angle = 270;
+        break;
+    case KScreen::Output::Inverted:
+        angle = 180;
+        break;
+    default:
+        break;
+    }
+
+    QTransform transform;
+    transform = transform.translate(float(internal.x()) / float(total.width()), float(internal.y()) / float(total.height()));
+    transform = transform.scale(float(internal.width()) / float(total.width()), float(internal.height()) / float(total.height()));
+    transform = transform.rotate(angle);
+    switch (angle) {
+    case 90:
+        transform = transform.translate(0, -1);
+        break;
+    case 270:
+        transform = transform.translate(-1, 0);
+        break;
+    case 180:
+        transform = transform.translate(-1, -1);
+        break;
+    default:
+        break;
+    }
+
+    const Atom touchScreenAtom = XInternAtom(display, XI_TOUCHSCREEN, True);
+    const Atom matrixAtom = XInternAtom(display, "Coordinate Transformation Matrix", True);
+    const Atom floatAtom = XInternAtom(display, "FLOAT", True);
+    if (touchScreenAtom == None || matrixAtom == None || floatAtom == None) {
+        return;
+    }
+
+    int nDevices = 0;
+    std::unique_ptr<XDeviceInfo, DeviceListDeleter> deviceInfo(XListInputDevices(display, &nDevices));
+    if (!deviceInfo) {
+        return;
+    }
+
+    for (XDeviceInfo *info = deviceInfo.get(); info < deviceInfo.get() + nDevices; ++info) {
+        if (info->type != touchScreenAtom) {
+            continue;
+        }
+
+        int nProperties = 0;
+        std::unique_ptr<Atom, XDeleter> properties(XIListProperties(display, info->id, &nProperties));
+        bool found = false;
+        for (int i = 0; i < nProperties; ++i) {
+            if (properties.get()[i] == matrixAtom) {
+                found = true;
+                break;
+            }
+        }
+        if (!found) {
+            continue;
+        }
+
+        Atom type = None;
+        int format = 0;
+        unsigned long nItems = 0;
+        unsigned long bytesAfter = 0;
+        unsigned char *dataPtr = nullptr;
+        XIGetProperty(display, info->id, matrixAtom, 0, 1000, False, AnyPropertyType, &type, &format, &nItems, &bytesAfter, &dataPtr);
+        std::unique_ptr<unsigned char, XDeleter> data(dataPtr);
+        if (nItems != 9 || format != int(sizeof(float) * CHAR_BIT) || type != floatAtom || !dataPtr) {
+            continue;
+        }
+
+        auto *values = reinterpret_cast<float *>(dataPtr);
+        values[0] = transform.m11();
+        values[1] = transform.m21();
+        values[2] = transform.m31();
+        values[3] = transform.m12();
+        values[4] = transform.m22();
+        values[5] = transform.m32();
+        values[6] = transform.m13();
+        values[7] = transform.m23();
+        values[8] = transform.m33();
+        XIChangeProperty(display, info->id, matrixAtom, type, format, PropModeReplace, dataPtr, int(nItems));
+        XFlush(display);
+        // The internal panel has one touchscreen. An external-only desktop
+        // uses the same single-device assumption as the old KDED module.
+        break;
+    }
+}
