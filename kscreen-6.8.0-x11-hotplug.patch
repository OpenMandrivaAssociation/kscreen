+namespace
+{
+bool dbusBool(const QVariant &value)
+{
+    if (value.metaType() == QMetaType::fromType<QDBusVariant>()) {
+        return value.value<QDBusVariant>().variant().toBool();
+    }
+    return value.toBool();
+}
+
+QString hashOf(const KScreen::ConfigPtr &config)
+{
+    QStringList hashes;
+    const auto outputs = config->connectedOutputs();
+    hashes.reserve(outputs.count());
+    for (const auto &output : outputs) {
+        hashes << output->hash();
+    }
+    std::sort(hashes.begin(), hashes.end());
+    const QByteArray digest = QCryptographicHash::hash(hashes.join(QString()).toLatin1(), QCryptographicHash::Md5);
+    return QString::fromLatin1(digest.toHex());
+}
+
+KScreen::ModePtr bestMode(const KScreen::OutputPtr &output)
+{
+    if (const auto preferred = output->preferredMode()) {
+        return preferred;
+    }
+    KScreen::ModePtr best;
+    for (const auto &mode : output->modes()) {
+        if (!best || mode->size().width() * mode->size().height() > best->size().width() * best->size().height()
+            || (mode->size() == best->size() && mode->refreshRate() > best->refreshRate())) {
+            best = mode;
+        }
+    }
+    return best;
+}
+
+QVariantMap metadataFor(const KScreen::OutputPtr &output)
+{
+    QVariantMap metadata;
+    metadata.insert(QStringLiteral("name"), output->name());
+    if (output->edid() && output->edid()->isValid()) {
+        metadata.insert(QStringLiteral("fullname"), output->edid()->deviceId());
+    }
+    return metadata;
+}
+}
+
+Manager::Manager(QObject *parent)
+    : QObject(parent)
+{
+    m_timer.setInterval(100);
+    m_timer.setSingleShot(true);
+    connect(&m_timer, &QTimer::timeout, this, &Manager::reconcile);
+}
+
+QString Manager::dataDir() const
+{
+    return QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + QStringLiteral("/kscreen/");
+}
+
+QString Manager::connectedHash() const
+{
+    return m_config ? hashOf(m_config) : QString();
+}
+
+void Manager::start()
+{
+    QDBusInterface upower(QStringLiteral("org.freedesktop.UPower"),
+                          QStringLiteral("/org/freedesktop/UPower"),
+                          QStringLiteral("org.freedesktop.DBus.Properties"),
+                          QDBusConnection::systemBus());
+    const QDBusReply<QVariant> lid = upower.call(QStringLiteral("Get"), QStringLiteral("org.freedesktop.UPower"), QStringLiteral("LidIsClosed"));
+    if (lid.isValid()) {
+        m_lidClosed = dbusBool(lid.value());
+    }
+    QDBusConnection::systemBus().connect(QStringLiteral("org.freedesktop.UPower"),
+                                         QStringLiteral("/org/freedesktop/UPower"),
+                                         QStringLiteral("org.freedesktop.DBus.Properties"),
+                                         QStringLiteral("PropertiesChanged"),
+                                         this,
+                                         SLOT(upowerPropertiesChanged(QString,QVariantMap,QStringList)));
+    QDBusConnection::sessionBus().connect(QStringLiteral("org.kde.Solid.PowerManagement"),
+                                          QStringLiteral("/org/kde/Solid/PowerManagement/Actions/SuspendSession"),
+                                          QStringLiteral("org.kde.Solid.PowerManagement.Actions.SuspendSession"),
+                                          QStringLiteral("resumingFromSuspend"),
+                                          this,
+                                          SLOT(resumed()));
+    requestConfig(0);
+}
+
+void Manager::requestConfig(int attempt)
+{
+    m_attempts = attempt;
+    connect(new KScreen::GetConfigOperation, &KScreen::GetConfigOperation::finished, this, [this](KScreen::ConfigOperation *op) {
+        if (op->hasError()) {
+            qCWarning(KSCREEN_X11) << "Failed to read the X11 output configuration:" << op->errorString();
+            if (m_attempts < 10) {
+                QTimer::singleShot(500, this, [this] {
+                    requestConfig(m_attempts + 1);
+                });
+            }
+            return;
+        }
+        adoptConfig(op->config());
+    });
+}
+
+void Manager::adoptConfig(const KScreen::ConfigPtr &config)
+{
+    if (!config) {
+        qCWarning(KSCREEN_X11) << "X11 output configuration is empty";
+        return;
+    }
+    m_config = config;
+    connect(KScreen::ConfigMonitor::instance(), &KScreen::ConfigMonitor::configurationChanged, this, [this] {
+        m_timer.start();
+    });
+    connect(m_config.data(), &KScreen::Config::outputAdded, this, [this](const KScreen::OutputPtr &) {
+        m_timer.start();
+    });
+    KScreen::ConfigMonitor::instance()->addConfig(m_config);
+    if (!m_timer.isActive()) {
+        m_timer.start();
+    }
+}
+
+void Manager::upowerPropertiesChanged(const QString &interface, const QVariantMap &changed, const QStringList &)
+{
+    if (interface != QLatin1String("org.freedesktop.UPower") || !changed.contains(QStringLiteral("LidIsClosed"))) {
+        return;
+    }
+    const bool closed = dbusBool(changed.value(QStringLiteral("LidIsClosed")));
+    if (closed == m_lidClosed) {
+        return;
+    }
+    m_lidClosed = closed;
+    if (!closed) {
+        // The open-lid layout is the one stored for this set of outputs.
+        m_lidHoldsPanelOff = false;
+        m_appliedHash.clear();
+    }
+    m_timer.start();
+}
+
+void Manager::resumed()
+{
+    // Force the XRandR backend to query the server. The result is discarded;
+    // a real change arrives through ConfigMonitor.
+    new KScreen::GetConfigOperation(KScreen::ConfigOperation::NoEDID);
+}
+
+void Manager::reconcile()
+{
+    if (!m_config || m_applying) {
+        if (m_applying) {
+            m_timer.start();
+        }
+        return;
+    }
+    const QString hash = connectedHash();
+    if (hash.isEmpty()) {
+        return;
+    }
+    if (hash != m_appliedHash) {
+        m_appliedHash = hash;
+        applyArrangement();
+        return;
+    }
+    // Closing the lid does not change which outputs are connected, so the
+    // saved layout would just turn the panel back on. Hold it off instead,
+    // and do not overwrite that layout.
+    if (m_lidClosed && !m_lidHoldsPanelOff) {
+        disablePanelIfExternal();
+        if (m_lidHoldsPanelOff) {
+            submit(false);
+            return;
+        }
+    }
+    if (!m_lidHoldsPanelOff) {
+        save();
+    }
+    alignX11TouchScreen(m_config);
+}
+
+void Manager::applyArrangement()
+{
+    const bool known = applySaved(m_appliedHash);
+    if (!known) {
+        applyIdeal();
+    }
+    if (m_lidClosed) {
+        disablePanelIfExternal();
+    }
+    const bool showOsd = !known && !m_initial && !m_lidHoldsPanelOff && m_config->connectedOutputs().count() > 1;
+    submit(showOsd);
+}
+
+bool Manager::applySaved(const QString &hash)
+{
+    QFile file(dataDir() + hash);
+    if (!file.open(QIODevice::ReadOnly)) {
+        return false;
+    }
+    const QVariantList entries = QJsonDocument::fromJson(file.readAll()).toVariant().toList();
+    if (entries.isEmpty()) {
+        return false;
+    }
+
+    QStringList seen;
+    QStringList duplicates;
+    const auto connected = m_config->connectedOutputs();
+    for (const auto &output : connected) {
+        const QString id = output->hash();
+        if (seen.contains(id) && !duplicates.contains(id)) {
+            duplicates << id;
+        }
+        seen << id;
+    }
+
+    bool matched = false;
+    const auto outputs = m_config->outputs();
+    for (const auto &output : outputs) {
+        if (!output->isConnected()) {
+            output->setEnabled(false);
+            continue;
+        }
+        const QString id = output->hash();
+        QVariantMap info;
+        for (const auto &entry : entries) {
+            const QVariantMap candidate = entry.toMap();
+            if (candidate.value(QStringLiteral("id")).toString() != id) {
+                continue;
+            }
+            if (duplicates.contains(id)) {
+                const QString name = candidate.value(QStringLiteral("metadata")).toMap().value(QStringLiteral("name")).toString();
+                if (name != output->name()) {
+                    continue;
+                }
+            }
+            info = candidate;
+            break;
+        }
+        if (info.isEmpty()) {
+            output->setEnabled(true);
+            if (const auto mode = bestMode(output)) {
+                output->setCurrentModeId(mode->id());
+            }
+            output->setExplicitLogicalSize(m_config->logicalSizeForOutput(*output));
+            continue;
+        }
+        matched = true;
+        output->setEnabled(info.value(QStringLiteral("enabled")).toBool());
+        const QVariantMap pos = info.value(QStringLiteral("pos")).toMap();
+        output->setPos(QPoint(pos.value(QStringLiteral("x")).toInt(), pos.value(QStringLiteral("y")).toInt()));
+        uint32_t priority = 0;
+        if (info.contains(QStringLiteral("priority"))) {
+            priority = info.value(QStringLiteral("priority")).toUInt();
+        } else if (info.contains(QStringLiteral("primary"))) {
+            priority = info.value(QStringLiteral("primary")).toBool() ? 1 : 2;
+        }
+        if (priority > 0) {
+            output->setPriority(priority);
+        }
+        applyModeFields(output, info);
+        const QVariantMap global = readGlobal(output);
+        if (!global.isEmpty()) {
+            applyModeFields(output, global);
+        }
+        output->setExplicitLogicalSize(m_config->logicalSizeForOutput(*output));
+    }
+    if (matched) {
+        m_config->adjustPriorities();
+    }
+    return matched;
+}
+
+QVariantMap Manager::readGlobal(const KScreen::OutputPtr &output) const
+{
+    const QString base = QStringLiteral("kscreen/outputs/") + output->hashMd5();
+    QString path = QStandardPaths::locate(QStandardPaths::GenericDataLocation, base + output->name());
+    if (path.isEmpty()) {
+        path = QStandardPaths::locate(QStandardPaths::GenericDataLocation, base);
+    }
+    if (path.isEmpty()) {
+        return {};
+    }
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly)) {
+        return {};
+    }
+    return QJsonDocument::fromJson(file.readAll()).toVariant().toMap();
+}
+
+void Manager::applyModeFields(const KScreen::OutputPtr &output, const QVariantMap &info)
+{
+    if (info.contains(QStringLiteral("rotation"))) {
+        output->setRotation(static_cast<KScreen::Output::Rotation>(info.value(QStringLiteral("rotation")).toInt()));
+    }
+    if (info.contains(QStringLiteral("scale"))) {
+        const double scale = info.value(QStringLiteral("scale")).toDouble();
+        if (scale > 0) {
+            output->setScale(scale);
+        }
+    }
+    if (info.contains(QStringLiteral("vrrpolicy"))) {
+        output->setVrrPolicy(static_cast<KScreen::Output::VrrPolicy>(info.value(QStringLiteral("vrrpolicy")).toUInt()));
+    }
+    if (info.contains(QStringLiteral("overscan"))) {
+        output->setOverscan(info.value(QStringLiteral("overscan")).toUInt());
+    }
+    if (info.contains(QStringLiteral("rgbrange"))) {
+        output->setRgbRange(static_cast<KScreen::Output::RgbRange>(info.value(QStringLiteral("rgbrange")).toUInt()));
+    }
+
+    const QVariantMap modeInfo = info.value(QStringLiteral("mode")).toMap();
+    const QVariantMap sizeMap = modeInfo.value(QStringLiteral("size")).toMap();
+    const QSize size(sizeMap.value(QStringLiteral("width")).toInt(), sizeMap.value(QStringLiteral("height")).toInt());
+    const float refresh = modeInfo.value(QStringLiteral("refresh")).toFloat();
+    if (!size.isValid()) {
+        return;
+    }
+    for (const auto &mode : output->modes()) {
+        if (mode->size() == size && std::abs(mode->refreshRate() - refresh) < 0.01f) {
+            output->setCurrentModeId(mode->id());
+            break;
+        }
+    }
+}
+
+void Manager::applyIdeal()
+{
+    QList<KScreen::OutputPtr> ordered;
+    const auto outputs = m_config->outputs();
+    for (const auto &output : outputs) {
+        if (!output->isConnected() || output->modes().isEmpty()) {
+            output->setEnabled(false);
+            continue;
+        }
+        ordered.append(output);
+    }
+    std::stable_sort(ordered.begin(), ordered.end(), [](const KScreen::OutputPtr &left, const KScreen::OutputPtr &right) {
+        return left->type() == KScreen::Output::Panel && right->type() != KScreen::Output::Panel;
+    });
+
+    int x = 0;
+    uint32_t priority = 1;
+    for (const auto &output : ordered) {
+        output->setEnabled(true);
+        if (const auto mode = bestMode(output)) {
+            output->setCurrentModeId(mode->id());
+        }
+        output->setExplicitLogicalSize(m_config->logicalSizeForOutput(*output));
+        output->setPos(QPoint(x, 0));
+        const int width = m_config->logicalSizeForOutputInt(*output).width();
+        x += std::max(1, width);
+        output->setPriority(priority);
+        ++priority;
+    }
+    m_config->adjustPriorities();
+    qCInfo(KSCREEN_X11) << "No saved layout for this set of outputs; extending them from left to right";
+}
+
+void Manager::disablePanelIfExternal()
+{
+    int external = 0;
+    KScreen::OutputPtr panel;
+    const auto outputs = m_config->connectedOutputs();
+    for (const auto &output : outputs) {
+        if (output->type() == KScreen::Output::Panel) {
+            if (!panel) {
+                panel = output;
+            }
+        } else {
+            ++external;
+        }
+    }
+    if (external == 0 || !panel) {
+        m_lidHoldsPanelOff = false;
+        return;
+    }
+
+    // The XRandR backend sizes the screen from the bounding box and then
+    // rejects any output whose right edge passes that width. A panel at the
+    // origin with an external monitor to its right would fail that test once
+    // the panel is disabled, so move those monitors left first. This matches
+    // the 6.7 KDED and is not written back over the open-lid layout.
+    if (panel->isEnabled()) {
+        const QRect geom = panel->geometry();
+        for (const auto &other : outputs) {
+            if (other == panel || !other->isEnabled()) {
+                continue;
+            }
+            QPoint otherPos = other->pos();
+            if (geom.isValid() && otherPos.x() >= geom.right() && otherPos.y() >= geom.top() && otherPos.y() <= geom.bottom()) {
+                otherPos.setX(otherPos.x() - geom.width());
+                other->setPos(otherPos);
+            }
+        }
+    }
+
+    m_lidHoldsPanelOff = true;
+    for (const auto &output : outputs) {
+        if (output->type() == KScreen::Output::Panel) {
+            output->setEnabled(false);
+        }
+    }
+    m_config->adjustPriorities();
+}
+
+void Manager::pinToOrigin()
+{
+    int minX = 0;
+    int minY = 0;
+    bool any = false;
+    const auto outputs = m_config->outputs();
+    for (const auto &output : outputs) {
+        if (!output->isConnected() || !output->isEnabled()) {
+            continue;
+        }
+        const QRect geom = output->geometry();
+        if (!geom.isValid()) {
+            continue;
+        }
+        if (!any) {
+            minX = geom.x();
+            minY = geom.y();
+            any = true;
+        } else {
+            minX = std::min(minX, geom.x());
+            minY = std::min(minY, geom.y());
+        }
+    }
+    if (!any || (minX == 0 && minY == 0)) {
+        return;
+    }
+    const QPoint shift(minX, minY);
+    for (const auto &output : outputs) {
+        if (!output->isConnected() || !output->isEnabled()) {
+            continue;
+        }
+        output->setPos(output->pos() - shift);
+    }
+}
+
+void Manager::submit(bool showOsd)
+{
+    m_applying = true;
+    pinToOrigin();
+    connect(new KScreen::SetConfigOperation(m_config), &KScreen::SetConfigOperation::finished, this, [this, showOsd](KScreen::ConfigOperation *op) {
+        m_applying = false;
+        m_initial = false;
+        if (op->hasError()) {
+            qCWarning(KSCREEN_X11) << "Failed to apply the X11 output configuration:" << op->errorString();
+        } else if (!m_lidHoldsPanelOff) {
+            save();
+        }
+        alignX11TouchScreen(m_config);
+        if (showOsd && !op->hasError()) {
+            QDBusMessage message = QDBusMessage::createMethodCall(QStringLiteral("org.kde.kscreen.osdService"),
+                                                                  QStringLiteral("/org/kde/kscreen/osdService"),
+                                                                  QStringLiteral("org.kde.kscreen.osdService"),
+                                                                  QStringLiteral("showActionSelector"));
+            QDBusConnection::sessionBus().asyncCall(message);
+        }
+    });
+}
+
+void Manager::save() const
+{
+    if (!m_config) {
+        return;
+    }
+    const QString hash = hashOf(m_config);
+    if (hash.isEmpty() || !QDir().mkpath(dataDir())) {
+        return;
+    }
+
+    const auto outputs = m_config->outputs();
+    const auto duplicated = [&outputs](const KScreen::OutputPtr &output) {
+        return std::any_of(outputs.cbegin(), outputs.cend(), [&output](const KScreen::OutputPtr &other) {
+            return other != output && other->isConnected() && other->hashMd5() == output->hashMd5();
+        });
+    };
+
+    QVariantList stored;
+    for (const auto &output : outputs) {
+        if (!output->isConnected() || !output->currentMode()) {
+            continue;
+        }
+        QVariantMap info;
+        info.insert(QStringLiteral("id"), output->hash());
+        info.insert(QStringLiteral("metadata"), metadataFor(output));
+        info.insert(QStringLiteral("rotation"), int(output->rotation()));
+        info.insert(QStringLiteral("scale"), int(output->scale() * 10000 + 0.5) / 10000.0);
+        QVariantMap modeSize;
+        modeSize.insert(QStringLiteral("width"), output->currentMode()->size().width());
+        modeSize.insert(QStringLiteral("height"), output->currentMode()->size().height());
+        QVariantMap mode;
+        mode.insert(QStringLiteral("refresh"), output->currentMode()->refreshRate());
+        mode.insert(QStringLiteral("size"), modeSize);
+        info.insert(QStringLiteral("mode"), mode);
+        info.insert(QStringLiteral("vrrpolicy"), static_cast<uint32_t>(output->vrrPolicy()));
+        info.insert(QStringLiteral("overscan"), output->overscan());
+        info.insert(QStringLiteral("rgbrange"), static_cast<uint32_t>(output->rgbRange()));
+        info.insert(QStringLiteral("priority"), output->priority());
+        info.insert(QStringLiteral("enabled"), output->isEnabled());
+        QVariantMap pos;
+        pos.insert(QStringLiteral("x"), output->pos().x());
+        pos.insert(QStringLiteral("y"), output->pos().y());
+        info.insert(QStringLiteral("pos"), pos);
+        stored.append(info);
+
+        if (!output->isEnabled()) {
+            continue;
+        }
+        const QString globalDir = dataDir() + QStringLiteral("outputs/");
+        if (!QDir().mkpath(globalDir)) {
+            continue;
+        }
+        QString globalPath = globalDir + output->hashMd5() + output->name();
+        if (!duplicated(output) && !QFile::exists(globalPath)) {
+            globalPath = globalDir + output->hashMd5();
+        }
+        QFile global(globalPath);
+        if (global.open(QIODevice::WriteOnly)) {
+            QVariantMap globalInfo = info;
+            globalInfo.remove(QStringLiteral("priority"));
+            globalInfo.remove(QStringLiteral("enabled"));
+            globalInfo.remove(QStringLiteral("pos"));
+            global.write(QJsonDocument::fromVariant(globalInfo).toJson());
+        }
+    }
+
+    QFile file(dataDir() + hash);
+    if (!file.open(QIODevice::WriteOnly)) {
+        qCWarning(KSCREEN_X11) << "Could not write" << file.fileName() << file.errorString();
+        return;
+    }
+    file.write(QJsonDocument::fromVariant(stored).toJson());
+    qCDebug(KSCREEN_X11) << "Saved X11 output layout to" << file.fileName();
+}
+
