+bool KCMKScreen::perOutputScaling() const
+{
+    // Config::Feature::PerOutputScaling was removed in libkscreen 6.8.
+    // Wayland still scales each output. X11 keeps one global factor.
+    return QGuiApplication::platformName().startsWith(QLatin1String("wayland"));
+}
+
+qreal KCMKScreen::globalScale() const
+{
+    if (m_globalScaleTouched) {
+        return GlobalScaleSettings::self()->scaleFactor();
+    }
+
+    auto group = KSharedConfig::openConfig(QStringLiteral("kdeglobals"))->group(QStringLiteral("KScreen"));
+    if (group.hasKey(QStringLiteral("ScaleFactor"))) {
+        return GlobalScaleSettings::self()->scaleFactor();
+    }
+
+    // 6.8 stopped writing ScaleFactor. A 6.7 150% is still in
+    // ScreenScaleFactors, which startplasma-x11 turns into
+    // QT_SCREEN_SCALE_FACTORS. Show that instead of the xrandr default of 1.
+    const qreal fromFactors = firstNonUnityScaleFactor(group.readEntry(QStringLiteral("ScreenScaleFactors"), QString()));
+    if (qAbs(fromFactors - 1.0) > 0.001) {
+        return fromFactors;
+    }
+    return GlobalScaleSettings::self()->scaleFactor();
+}
+
+void KCMKScreen::setGlobalScale(qreal scale)
+{
+    m_globalScaleTouched = true;
+    GlobalScaleSettings::self()->setScaleFactor(scale);
+    Q_EMIT changed();
+}
+
+void KCMKScreen::exportGlobalScale()
+{
+    // Session startup copies ScreenScaleFactors into QT_SCREEN_SCALE_FACTORS.
+    // That variable does not scale fonts (unlike QT_SCALE_FACTOR). Plasmashell
+    // and X11 clients follow Xft.dpi / forceFontDPI, so both have to move together.
+    QString screenFactors;
+    const auto outputs = m_configHandler->config()->outputs();
+    for (const auto &output : outputs) {
+        screenFactors.append(output->name() + QLatin1Char('=') + QString::number(globalScale()) + QLatin1Char(';'));
+    }
+    auto config = KSharedConfig::openConfig(QStringLiteral("kdeglobals"));
+    config->group(QStringLiteral("KScreen")).writeEntry(QStringLiteral("ScreenScaleFactors"), screenFactors);
+    config->sync();
+
+    KConfig fontConfig(QStringLiteral("kcmfonts"));
+    auto fontConfigGroup = fontConfig.group(QStringLiteral("General"));
+
+    if (qAbs(globalScale() - 1.0) <= 0.001) {
+        QProcess queryProc;
+        queryProc.start(QStringLiteral("xrdb"), {QStringLiteral("-query")});
+        if (queryProc.waitForFinished()) {
+            QByteArray db = queryProc.readAllStandardOutput();
+            int idx1 = 0;
+            while (idx1 < db.size()) {
+                int idx2 = db.indexOf('\n', idx1);
+                if (idx2 == -1) {
+                    idx2 = db.size() - 1;
+                }
+                const auto entry = QByteArray::fromRawData(db.constData() + idx1, idx2 - idx1 + 1);
+                if (entry.startsWith("Xft.dpi:")) {
+                    db.remove(idx1, entry.size());
+                } else {
+                    idx1 = idx2 + 1;
+                }
+            }
+
+            QProcess loadProc;
+            loadProc.start(QStringLiteral("xrdb"), {QStringLiteral("-quiet"), QStringLiteral("-load"), QStringLiteral("-nocpp")});
+            if (loadProc.waitForStarted()) {
+                loadProc.write(db);
+                loadProc.closeWriteChannel();
+                loadProc.waitForFinished();
+            }
+        }
+        fontConfigGroup.writeEntry(QStringLiteral("forceFontDPI"), 0, KConfig::Notify);
+    } else {
+        const int scaleDpi = qRound(globalScale() * 96.0);
+        QProcess proc;
+        proc.start(QStringLiteral("xrdb"), {QStringLiteral("-quiet"), QStringLiteral("-merge"), QStringLiteral("-nocpp")});
+        if (proc.waitForStarted()) {
+            proc.write(QByteArray("Xft.dpi: ") + QByteArray::number(scaleDpi));
+            proc.closeWriteChannel();
+            proc.waitForFinished();
+        }
+        fontConfigGroup.writeEntry(QStringLiteral("forceFontDPI"), scaleDpi, KConfig::Notify);
+    }
+    fontConfig.sync();
+
+    Q_EMIT globalScaleWritten();
+}
