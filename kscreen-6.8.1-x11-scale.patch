+// QT_SCREEN_SCALE_FACTORS is stored as "name=factor;name=factor;".
+// QString::number() writes these with the C locale.
+qreal firstNonUnityScaleFactor(const QString &factors)
+{
+    const auto parts = factors.split(QLatin1Char(';'), Qt::SkipEmptyParts);
+    for (const QString &part : parts) {
+        const int eq = part.indexOf(QLatin1Char('='));
+        if (eq < 0) {
+            continue;
+        }
+        bool ok = false;
+        const qreal value = QLocale::c().toDouble(part.mid(eq + 1), &ok);
+        if (ok && qAbs(value - 1.0) > 0.001) {
+            return value;
+        }
+    }
+    return 1.0;
+}
+
+// A CRTC transform is cleared only when the explicit logical size is the
+// oriented mode size. An invalid size is what GetConfig already reports, and
+// the xrandr backend then leaves the current transform in place.
+void resetX11OutputScale(const KScreen::ConfigPtr &config)
+{
+    const auto outputs = config->outputs();
+    for (const KScreen::OutputPtr &output : outputs) {
+        if (!output) {
+            continue;
+        }
+        output->setScale(1.0);
+        QSizeF size = output->enforcedModeSize();
+        if (!size.isValid()) {
+            continue;
+        }
+        if (!output->isHorizontal()) {
+            size = size.transposed();
+        }
+        output->setExplicitLogicalSize(size);
+    }
+}
+}
